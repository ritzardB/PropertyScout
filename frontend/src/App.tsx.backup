import { useEffect, useState } from 'react'
import {
  Activity, Building2, ChartNoAxesCombined, ChevronDown,
  CircleHelp, Compass, Home, MapPin, Search, Settings2,
  ShieldCheck, SlidersHorizontal, Warehouse,
} from 'lucide-react'

const propertyTypes = [
  'All properties',
  'Apartments',
  'Villas',
  'Commercial',
  'Offices',
  'Retail shops',
  'Warehouses',
  'Commercial buildings',
]

function App() {
  const [emirate, setEmirate] = useState('Abu Dhabi')
  const [propertyType, setPropertyType] = useState('All properties')
  const [search, setSearch] = useState('')
  const [apiStatus, setApiStatus] = useState('Checking connection')

  useEffect(() => {
    fetch('/api/health')
      .then((response) => {
        if (!response.ok) throw new Error('API unavailable')
        return response.json()
      })
      .then(() => setApiStatus('API connected'))
      .catch(() => setApiStatus('API offline'))
  }, [])

  return (
    <div className="min-h-screen bg-[#0b1020] text-slate-100 md:flex">
      <aside className="flex w-full shrink-0 flex-col border-b border-white/10 bg-[#0e1528] p-5 md:min-h-screen md:w-64 md:border-r md:border-b-0">
        <div className="mb-10 flex items-center gap-3">
          <div className="rounded-xl bg-cyan-400 p-2 text-slate-950">
            <Building2 size={25} />
          </div>
          <div>
            <h1 className="font-bold tracking-wide">PropertyScout</h1>
            <p className="text-xs text-slate-400">UAE PROPERTY INTELLIGENCE</p>
          </div>
        </div>

        <p className="mb-3 text-xs font-semibold tracking-widest text-slate-500">WORKSPACE</p>
        <nav className="space-y-2">
          <div className="flex items-center gap-3 rounded-xl bg-cyan-400/10 px-4 py-3 font-medium text-cyan-300">
            <Compass size={19} /> Overview
          </div>
          <div className="flex items-center gap-3 px-4 py-3 text-slate-400">
            <Home size={19} /> Rental discovery
          </div>
          <div className="flex items-center gap-3 px-4 py-3 text-slate-400">
            <ChartNoAxesCombined size={19} /> Sales analytics
          </div>
          <div className="flex items-center gap-3 px-4 py-3 text-slate-400">
            <Warehouse size={19} /> Commercial properties
          </div>
        </nav>

        <div className="mt-8 rounded-xl border border-white/10 p-4">
          <div className="mb-2 flex items-center gap-2 text-sm font-medium">
            <Activity size={17} className="text-cyan-300" /> Backend status
          </div>
          <p className={`text-sm ${apiStatus === 'API connected' ? 'text-emerald-400' : 'text-amber-300'}`}>
            {apiStatus}
          </p>
          <p className="mt-2 text-xs text-slate-500">FastAPI · Local development</p>
        </div>

        <div className="mt-auto hidden space-y-4 pt-10 text-sm text-slate-400 md:block">
          <div className="flex items-center gap-3"><Settings2 size={17} /> Settings</div>
          <div className="flex items-center gap-3"><CircleHelp size={17} /> Help & support</div>
        </div>
      </aside>

      <main className="min-w-0 flex-1 p-5 md:p-9">
        <header className="mb-8 flex flex-wrap items-center justify-between gap-4">
          <div>
            <p className="mb-1 text-sm text-slate-400">UAE PROPERTY INTELLIGENCE PLATFORM</p>
            <h2 className="text-2xl font-bold md:text-3xl">Property overview</h2>
            <p className="mt-2 text-sm text-slate-400">Discover opportunities. Understand markets. Find your next client.</p>
          </div>
          <div className="flex items-center gap-2 rounded-full border border-white/10 px-4 py-2 text-sm text-slate-300">
            <ShieldCheck size={17} className="text-emerald-400" /> Data-aware workspace
          </div>
        </header>

        <section className="mb-8 rounded-2xl border border-cyan-300/20 bg-gradient-to-br from-[#142843] to-[#11172a] p-6 md:p-8">
          <p className="mb-3 text-sm font-semibold text-cyan-300">PROPERTY DISCOVERY</p>
          <h3 className="max-w-2xl text-2xl font-bold md:text-3xl">Find properties. Uncover opportunities.</h3>
          <p className="mt-3 max-w-2xl text-sm leading-6 text-slate-300">
            Explore advertised rental opportunities across Abu Dhabi and Dubai, with sales-market analytics powered by your existing DLD and ADREC datasets.
          </p>

          <div className="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <label className="text-xs text-slate-400">
              EMIRATE
              <span className="relative mt-2 block">
                <MapPin size={16} className="absolute left-3 top-3 text-cyan-300" />
                <select value={emirate} onChange={(e) => setEmirate(e.target.value)} className="w-full appearance-none rounded-lg border border-white/10 bg-[#0b1425] py-3 pl-9 pr-8 text-sm text-white outline-none focus:border-cyan-300">
                  <option>Abu Dhabi</option>
                  <option>Dubai</option>
                </select>
                <ChevronDown size={15} className="pointer-events-none absolute right-3 top-3 text-slate-400" />
              </span>
            </label>

            <label className="text-xs text-slate-400">
              PROPERTY TYPE
              <span className="relative mt-2 block">
                <select value={propertyType} onChange={(e) => setPropertyType(e.target.value)} className="w-full appearance-none rounded-lg border border-white/10 bg-[#0b1425] px-3 py-3 pr-8 text-sm text-white outline-none focus:border-cyan-300">
                  {propertyTypes.map((type) => <option key={type}>{type}</option>)}
                </select>
                <ChevronDown size={15} className="pointer-events-none absolute right-3 top-3 text-slate-400" />
              </span>
            </label>

            <label className="text-xs text-slate-400">
              AREA OR COMMUNITY
              <span className="relative mt-2 block">
                <Search size={16} className="absolute left-3 top-3 text-slate-500" />
                <input value={search} onChange={(e) => setSearch(e.target.value)} placeholder="e.g. Al Reem Island" className="w-full rounded-lg border border-white/10 bg-[#0b1425] py-3 pl-9 pr-3 text-sm text-white outline-none placeholder:text-slate-600 focus:border-cyan-300" />
              </span>
            </label>

            <div className="flex items-end">
              <button onClick={() => window.alert(`Selected: ${emirate} · ${propertyType}${search ? ` · ${search}` : ''}. Listing search will be connected when the rental API is implemented.`)} className="flex w-full items-center justify-center gap-2 rounded-lg bg-cyan-300 px-4 py-3 text-sm font-bold text-slate-950 transition hover:bg-cyan-200">
                <SlidersHorizontal size={17} /> Explore properties
              </button>
            </div>
          </div>
        </section>

        <div className="mb-4 flex items-center justify-between">
          <h3 className="text-lg font-semibold">Your intelligence workspace</h3>
          <span className="text-xs text-slate-500">Live data requires connected sources</span>
        </div>

        <section className="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
          {[
            { title: 'Rental discovery', detail: 'Advertised listings across both emirates', icon: Home, status: 'Next module' },
            { title: 'Sales comparables', detail: 'Compare recorded transactions and prices', icon: ChartNoAxesCombined, status: 'API available' },
            { title: 'Commercial search', detail: 'Offices, retail, warehouses and buildings', icon: Warehouse, status: 'Planned module' },
          ].map(({ title, detail, icon: Icon, status }) => (
            <article key={title} className="rounded-2xl border border-white/10 bg-[#11192b] p-5">
              <div className="mb-5 flex items-center justify-between">
                <div className="rounded-xl bg-white/5 p-3 text-cyan-300"><Icon size={22} /></div>
                <span className="rounded-full border border-white/10 px-3 py-1 text-xs text-slate-400">{status}</span>
              </div>
              <h4 className="font-semibold">{title}</h4>
              <p className="mt-2 text-sm leading-6 text-slate-400">{detail}</p>
            </article>
          ))}
        </section>

        <footer className="mt-8 border-t border-white/10 pt-5 text-xs leading-6 text-slate-500">
          PropertyScout UAE · Advertised availability is not confirmation of vacancy. Rental listings will require an authorized source and availability status.
        </footer>
      </main>
    </div>
  )
}

export default App
